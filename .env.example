# Copy to .env and fill in. `npm run dev` and `npm start` load it automatically.

# Postgres connection string. Leave unset in development to use the embedded
# PGlite database in .data/ instead.
# DATABASE_URL=postgres://user:password@localhost:5432/vectorfield

# OAuth client ID for "Sign in with Google" — Google Cloud Console →
# APIs & Services → Credentials → Create credentials → OAuth client ID →
# Web application. Add http://localhost:3000 (and your real origin) under
# "Authorized JavaScript origins".
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Optional: "Sign in with Apple" — the Services ID from Apple Developer →
# Certificates, Identifiers & Profiles → Identifiers → Services IDs. Enable
# Sign in with Apple on it, add your domain, and add https://<your domain>/
# as a return URL. Apple rejects localhost; test locally over an HTTPS tunnel.
# APPLE_CLIENT_ID=com.example.vectorfield.web

# Local sign-in without Google, for development only. Ignored in production.
DEV_LOGIN=1

# The site's public origin, used for the absolute links in share previews
# (Facebook, Reddit…), embed codes and emails. Set it in production; locally
# the request's host is used.
# PUBLIC_URL=https://vectorfield.example

# Recovery emails for password accounts (confirming the address, reset
# links). Off unless set to 1. On in production, it needs SMTP_URL and
# PUBLIC_URL; on in development without SMTP_URL, emails are printed to the
# server log.
# RECOVERY_EMAIL=1

# How to send them: any provider's SMTP server, as a URL (smtps:// for TLS
# on 465, smtp:// for STARTTLS on 587). Ignored while RECOVERY_EMAIL is off.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# Who emails are from. Unset: no-reply@ at PUBLIC_URL's domain.
# MAIL_FROM=Vectorfield <no-reply@vectorfield.example>

# Behind a reverse proxy (most hosts), which visitor address to believe from
# X-Forwarded-For: usually the number of proxies in front. Limits on password
# guessing are kept per address, so without it every visitor looks like the
# proxy and they share one limit. Leave unset when nothing is in front.
# TRUST_PROXY=1

# PORT=3000
